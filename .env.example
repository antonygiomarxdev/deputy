# ── General ─────────────────────────────────────────────
# WhatsApp provider: meta | kapso | dev (local testing, no WhatsApp)
DEPUTY_PROVIDER=dev
# Where the catalog and orders live: local (CSV) | sheets (Google Sheets)
DEPUTY_STORE=local
# Your number(s), digits only, comma separated (country code, no +).
# These are trusted: they can give Deputy instructions and approve permissions.
DEPUTY_OWNERS=15551234567
DEPUTY_PORT=8788
DEPUTY_HOST=127.0.0.1
# Minutes Deputy stays quiet in a chat after you reply by hand from the app (Coexistence)
DEPUTY_ECHO_PAUSE_MIN=30
# Send Claude Code permission prompts to your WhatsApp ("yes abcde" / "no abcde")
DEPUTY_PERMISSION_RELAY=true
# Language of the few messages Deputy writes to you itself: en | es
DEPUTY_LANG=en
# Business profile folder (business.md + catalog.csv)
# DEPUTY_BUSINESS_DIR=business

# ── Meta direct (DEPUTY_PROVIDER=meta) ──────────────────
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
# Any string you make up; use the same one in Meta's webhook settings
META_VERIFY_TOKEN=
# META_GRAPH_VERSION=v23.0

# ── Kapso (DEPUTY_PROVIDER=kapso) ───────────────────────
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=

# ── Google Sheets (DEPUTY_STORE=sheets) ─────────────────
SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# SHEETS_CATALOG_TAB=Catalog
# SHEETS_ORDERS_TAB=Orders
