{
  "name": "deputy",
  "version": "0.0.0",
  "description": "Let your Claude Code agent answer WhatsApp for you. A Claude Code channel with pluggable providers (Meta Cloud API direct, Kapso) and a catalog/orders store (CSV or Google Sheets).",
  "scripts": {
    "start": "bun src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run typecheck && bun test && changeset publish"
  },
  "keywords": [
    "claude-code",
    "mcp",
    "whatsapp",
    "channel",
    "agent"
  ],
  "author": "Antony Giomar <antonygiomarx@gmail.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "deputy": "src/server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonygiomarxdev/deputy.git"
  },
  "homepage": "https://github.com/antonygiomarxdev/deputy",
  "engines": {
    "bun": ">=1.2"
  },
  "files": [
    "src",
    "operator",
    "business",
    "examples",
    "scripts",
    ".env.example"
  ],
  "private": true
}
